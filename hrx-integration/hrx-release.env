# Pinned HRX (amdxdna) release consumed by the HRX runtime path.
#
# PUBLIC SOURCE (preferred): fastflow-sdk.env + provision-hrx-from-fastflow-sdk.sh
# build this SAME HRX commit (e53f299) from the public FastFlow SDK
# (ROCm/FastFlow-SDK -> ROCm/hrx-system) via `dev.py build hrx`. This env/script
# pair below downloads a prebuilt tarball from the private jtuyls/hrx fork and is
# retained as an offline/legacy fallback. Both yield the same find_package(hrx)
# dev package prefix under ./.hrx-release/.
HRX_RELEASE_REPO="jtuyls/hrx"
HRX_RELEASE_TAG="flm-hrx-amdxdna-v2026.10.13"
# For Linux.
HRX_RELEASE_ASSET="hrx-amdxdna-2026.10.13-amdxdna-hal-native-rel-e53f299-linux-x86_64.tar.zst"
HRX_RELEASE_SHA256="4782a49358981a126e3cc8e546a55004efdd038c5ed8dc64838c49d549be6d63"
# For Windows.
HRX_RELEASE_ASSET_WINDOWS="hrx-amdxdna-2026.10.13-amdxdna-hal-native-rel-e53f299-windows-x86_64.zip"
HRX_RELEASE_SHA256_WINDOWS="20072c09d589e0ce36316e64d425198fc9e5668ed8a642a648ea801cb9d72789"
